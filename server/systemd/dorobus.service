# systemd 사용자 서비스. 설치 위치: ~/.config/systemd/user/dorobus.service
# DOROBUS 프로토타입(정적 빌드 파일)을 내부 포트로만 띄운다. Caddy가 HTTPS로 받아 여기로 넘긴다.
[Unit]
Description=DOROBUS prototype static site
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 8795 --bind 127.0.0.1 --directory %h/dorobus/dist
Restart=on-failure
RestartSec=5
# 다른 서비스에 영향이 없도록 자원을 제한한다.
MemoryMax=128M
CPUQuota=50%
Nice=5

[Install]
WantedBy=default.target
